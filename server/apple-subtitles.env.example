BIND=127.0.0.1
PORT=8765
ACCESS_TOKEN=replace-with-a-long-random-token
CACHE_DIR=/var/lib/apple-subtitles/cache
MAX_CACHE_ENTRIES=200
SUBDL_API_KEY=
SUBDL_CHINESE_LANGUAGES=ZH,ZH_BG,ZH_TW
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BATCH_SIZE=220
GEMINI_CONCURRENCY=3
HTTP_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
